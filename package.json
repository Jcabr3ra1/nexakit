{
  "name": "nexakit",
  "version": "0.12.2",
  "description": "Asistente por pasos de skills verificadas por SHA-256, coordinación entre agentes y memoria por proyecto para Claude Code y Codex.",
  "type": "module",
  "bin": {
    "nexakit": "bin/nexakit.js",
    "agent-toolkit": "bin/agent-toolkit.js",
    "project-memory": "bin/project-memory.js",
    "nexakit-fabrica-mcp": "bin/nexakit-fabrica-mcp.js",
    "project-memory-mcp": "bin/project-memory-mcp.js",
    "agent-toolkit-gemini": "bin/agent-toolkit-gemini.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test --import ./test-support/git-quiet.js \"test/*.test.js\"",
    "catalog:validate": "node scripts/validate-skill-catalog.js",
    "catalog:files": "node scripts/validate-skill-catalog.js --files",
    "catalog:add": "node scripts/add-catalog-skill.js",
    "prepack": "npm run build && node scripts/prepare-package.js",
    "test:mod": "claude plugin test plugins/nexakit-modelo",
    "plugins:huellas": "node scripts/plugin-huellas.js",
    "tipos:codex": "node scripts/generar-tipos-codex.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.7.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/server-filesystem": "2.3.0",
    "ajv": "^8.17.1",
    "toml-eslint-parser": "1.0.3",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "skills",
    "claude-code",
    "codex",
    "mcp",
    "project-memory",
    "nexakit"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jcabr3ra1/nexakit.git"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "skills/",
    "catalogs/",
    "agents/",
    "plugins/",
    "schemas/",
    "templates/",
    ".claude-plugin/",
    ".claude/skills/",
    ".agents/skills/",
    "assets/brand/",
    "docs/skills/evidencias/",
    "assets/runtime/",
    "bench/",
    "scripts/prepare-package.js",
    "scripts/validate-skill-catalog.js"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
